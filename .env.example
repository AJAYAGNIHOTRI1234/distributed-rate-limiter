APP_ENV=development
FRONTEND_URL=http://localhost:5500

JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5500/pages/login.html

# MongoDB
# Local: mongodb://localhost:27017/rateguard
# Docker: mongodb://admin:secret@mongodb:27017/rateguard?authSource=admin
MONGO_URL=mongodb://localhost:27017/rateguard
MONGO_DB=rateguard

# Redis
# Local: redis://localhost:6379/0
# Docker: redis://:redispass@redis:6379/0
REDIS_URL=redis://localhost:6379/0
